# VPS/Docker Management System Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# VPS CONNECTION CONFIGURATION
# ============================================================================

# Primary VPS Server Details
VPS_IP=217.79.255.54
VPS_USERNAME=root
VPS_PASSWORD=your_secure_password_here

# SSH Configuration
SSH_KEY_PATH=~/.ssh/vps_key
SSH_PORT=22
SSH_ADMIN_PORT=22222

# Connection Settings
CONNECTION_TIMEOUT=30
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=5

# ============================================================================
# CLOUDFLARE INTEGRATION
# ============================================================================

# Cloudflare API Configuration
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here
CLOUDFLARE_EMAIL=your_cloudflare_email@example.com

# DNS Configuration
DEFAULT_DOMAIN=consulting.sa
CLOUDFLARE_PROXY_ENABLED=true
DNS_TTL=300

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

# Default Deployment Settings
DEFAULT_ENVIRONMENT=production
DOCKER_REGISTRY=docker.io
COMPOSE_PROJECT_NAME=vps-docker-mgmt

# Container Configuration
CONTAINER_RESTART_POLICY=unless-stopped
CONTAINER_MEMORY_LIMIT=1g
CONTAINER_CPU_LIMIT=1.0

# Network Configuration
DOCKER_NETWORK_NAME=vps-docker-network
DOCKER_NETWORK_SUBNET=172.20.0.0/16

# ============================================================================
# SSL CERTIFICATE MANAGEMENT
# ============================================================================

# SSL Configuration
SSL_PROVIDER=cloudflare
SSL_AUTO_RENEW=true
SSL_RENEWAL_DAYS_BEFORE=30
SSL_KEY_SIZE=2048

# Certificate Storage
SSL_CERT_PATH=/opt/ssl/certificates
SSL_KEY_PATH=/opt/ssl/private
SSL_BACKUP_PATH=/opt/ssl/backups

# ============================================================================
# MONITORING AND HEALTH CHECKS
# ============================================================================

# Monitoring Configuration
MONITORING_ENABLED=true
HEALTH_CHECK_INTERVAL=60
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Metrics and Logging
METRICS_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30
LOG_LEVEL=INFO

# Alert Configuration
ALERTS_ENABLED=true
ALERTS_WEBHOOK_URL=https://your-webhook-url.com/alerts
ALERTS_EMAIL=admin@yourdomain.com

# ============================================================================
# BACKUP AND MAINTENANCE
# ============================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/opt/backups
BACKUP_COMPRESSION=gzip

# Maintenance Settings
AUTO_UPDATE_ENABLED=false
MAINTENANCE_WINDOW_START=02:00
MAINTENANCE_WINDOW_END=04:00
MAINTENANCE_TIMEZONE=UTC

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Firewall Settings
UFW_ENABLED=true
UFW_DEFAULT_INCOMING=deny
UFW_DEFAULT_OUTGOING=allow

# Fail2ban Configuration
FAIL2BAN_ENABLED=true
FAIL2BAN_MAX_RETRY=3
FAIL2BAN_BAN_TIME=3600
FAIL2BAN_FIND_TIME=600

# Security Scanning
SECURITY_SCAN_ENABLED=true
VULNERABILITY_SCAN_SCHEDULE="0 2 * * 0"  # Weekly on Sunday at 2 AM

# ============================================================================
# PROXY CONFIGURATION
# ============================================================================

# Proxy Server Settings
PROXY_TYPE=nginx  # nginx or caddy
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Nginx Specific Settings
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
NGINX_CLIENT_MAX_BODY_SIZE=10M

# Caddy Specific Settings
CADDY_ADMIN_PORT=2019
CADDY_AUTO_HTTPS=true

# ============================================================================
# APPLICATION SPECIFIC SETTINGS
# ============================================================================

# Frontend Configuration
FRONTEND_PORT=3000
FRONTEND_DEV_PORT=3001
FRONTEND_IMAGE=your-registry/frontend:latest

# Backend Configuration
BACKEND_PORT=8000
BACKEND_DEV_PORT=8001
BACKEND_IMAGE=your-registry/backend:latest

# Database Configuration
DATABASE_PORT=5432
DATABASE_DEV_PORT=5433
DATABASE_IMAGE=postgres:15

# Redis Configuration
REDIS_PORT=6379
REDIS_DEV_PORT=6380
REDIS_IMAGE=redis:7-alpine

# N8N Configuration
N8N_PORT=5678
N8N_DEV_PORT=5679
N8N_IMAGE=n8nio/n8n:latest

# ============================================================================
# DEVELOPMENT ENVIRONMENT OVERRIDES
# ============================================================================

# Development Environment Settings (uncomment for dev environment)
# DEFAULT_ENVIRONMENT=development
# FRONTEND_PORT=3001
# BACKEND_PORT=8001
# DATABASE_PORT=5433
# REDIS_PORT=6380
# N8N_PORT=5679

# ============================================================================
# STAGING ENVIRONMENT OVERRIDES
# ============================================================================

# Staging Environment Settings (uncomment for staging environment)
# DEFAULT_ENVIRONMENT=staging
# DEFAULT_DOMAIN=staging.consulting.sa
# FRONTEND_PORT=3002
# BACKEND_PORT=8002
# DATABASE_PORT=5434
# REDIS_PORT=6381
# N8N_PORT=5680

# ============================================================================
# ADVANCED CONFIGURATION
# ============================================================================

# Performance Tuning
MAX_CONCURRENT_DEPLOYMENTS=3
DEPLOYMENT_TIMEOUT=1800  # 30 minutes
CONTAINER_START_TIMEOUT=300  # 5 minutes

# Resource Limits
MAX_CPU_USAGE_PERCENT=80
MAX_MEMORY_USAGE_PERCENT=85
MAX_DISK_USAGE_PERCENT=90

# Notification Settings
NOTIFICATION_CHANNELS=webhook,email
NOTIFICATION_SEVERITY_THRESHOLD=warning

# Debug and Development
DEBUG_MODE=false
VERBOSE_LOGGING=false
DRY_RUN_MODE=false

# ============================================================================
# CUSTOM ENVIRONMENT VARIABLES
# ============================================================================

# Add your custom environment variables here
# CUSTOM_VAR_1=value1
# CUSTOM_VAR_2=value2

# ============================================================================
# NOTES AND DOCUMENTATION
# ============================================================================

# Configuration Notes:
# 1. Replace all placeholder values with your actual configuration
# 2. Keep sensitive information secure and never commit to version control
# 3. Use different .env files for different environments (production, staging, development)
# 4. Regularly rotate passwords and API tokens
# 5. Test configuration changes in development environment first

# Required External Services:
# - VPS server with Debian 12
# - Cloudflare account with API access
# - Docker registry access
# - Webhook endpoint for alerts (optional)
# - Email service for notifications (optional)

# Security Recommendations:
# - Use SSH keys instead of passwords when possible
# - Enable two-factor authentication for Cloudflare
# - Regularly update and patch the VPS server
# - Monitor access logs and security events
# - Use strong, unique passwords for all services