# =============================================================================
# HELPER FUNCTIONS FOR ENVIRONMENT SWITCHING
# =============================================================================

# Function to switch to development environment
switch_to_dev() {
    export VPS_IP="217.79.255.54"
    export VPS_USER="root"
    export VPS_PASSWORD="gnqLG7FDd4"
    export VPS_ENVIRONMENT="development"
    export VPS_DOMAIN="dev.consulting.sa"
    export SSH_ALIAS="agentic-217-79-255-54-development"
    export FRONTEND_PORT="3001"
    export BACKEND_PORT="8001"
    export REDIS_PORT="6380"
    export N8N_PORT="5679"
    echo "✅ Switched to DEVELOPMENT environment (217.79.255.54)"
}

# Function to switch to production environment
switch_to_prod() {
    export VPS_IP="217.79.255.54"
    export VPS_USER="root"
    export VPS_PASSWORD="gnqLG7FDd4"
    export VPS_ENVIRONMENT="production"
    export VPS_DOMAIN="consulting.sa"
    export SSH_ALIAS="agentic-217-79-255-54-production"
    export FRONTEND_PORT="3000"
    export BACKEND_PORT="8000"
    export REDIS_PORT="6379"
    export N8N_PORT="5678"
    echo "✅ Switched to PRODUCTION environment (217.79.255.54)"
}

# Function to switch to staging environment
switch_to_staging() {
    export VPS_IP="192.168.1.100"
    export VPS_USER="root"
    export VPS_PASSWORD="staging_password"
    export VPS_ENVIRONMENT="staging"
    export VPS_DOMAIN="staging.consulting.sa"
    export SSH_ALIAS="agentic-staging"
    export FRONTEND_PORT="3002"
    export BACKEND_PORT="8002"
    export REDIS_PORT="6381"
    export N8N_PORT="5680"
    echo "✅ Switched to STAGING environment (192.168.1.100)"
}

# Function to show current environment
show_current_env() {
    echo "🔧 Current VPS Environment:"
    echo "   IP: $VPS_IP"
    echo "   User: $VPS_USER"
    echo "   Environment: $VPS_ENVIRONMENT"
    echo "   Domain: $VPS_DOMAIN"
    echo "   SSH Alias: $SSH_ALIAS"
    echo "   Frontend Port: $FRONTEND_PORT"
    echo "   Backend Port: $BACKEND_PORT"
}

# =============================================================================
# USAGE INSTRUCTIONS
# =============================================================================
#
# To use this configuration:
#
# 1. Source this file:
#    source infrastructure/config/vps-environments.env
#
# 2. Switch environments:
#    switch_to_dev      # Switch to development
#    switch_to_prod     # Switch to production
#    switch_to_staging  # Switch to staging
#
# 3. Show current environment:
#    show_current_env
#
# 4. Run deployment with current environment:
#    ./infrastructure/scripts/setup-fresh-vps.sh $VPS_IP $VPS_PASSWORD $VPS_ENVIRONMENT
#    ./infrastructure/scripts/deploy-to-clean-vps.sh $SSH_ALIAS $VPS_ENVIRONMENT
#
# =============================================================================

