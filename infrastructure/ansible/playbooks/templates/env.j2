# Environment configuration for {{ environment }}
ENVIRONMENT={{ environment }}

# Database Configuration
DATABASE_URL={{ env_vars.database_url }}

# Supabase Configuration
SUPABASE_URL={{ env_vars.supabase_url }}
SUPABASE_ANON_KEY={{ env_vars.supabase_anon_key }}
SUPABASE_SERVICE_KEY={{ env_vars.supabase_service_key }}

# AI Configuration
GEMINI_API_KEY={{ env_vars.gemini_api_key }}

# n8n Configuration
N8N_URL={{ env_vars.n8n_url }}
N8N_API_KEY={{ env_vars.n8n_api_key }}

# MCP Configuration
MCP_SERVER_URL={{ env_vars.mcp_server_url }}

# Livekit Configuration
LIVEKIT_URL={{ env_vars.livekit_url }}
LIVEKIT_API_KEY={{ env_vars.livekit_api_key }}
LIVEKIT_SECRET_KEY={{ env_vars.livekit_secret_key }}

# Stripe Configuration
STRIPE_SECRET_KEY={{ env_vars.stripe_secret_key }}
STRIPE_WEBHOOK_SECRET={{ env_vars.stripe_webhook_secret }}

# Docker Images
FRONTEND_IMAGE={{ env_vars.frontend_image | default('ghcr.io/consulting-sa/agentic-frontend:latest') }}
BACKEND_IMAGE={{ env_vars.backend_image | default('ghcr.io/consulting-sa/agentic-backend:latest') }}

# Monitoring (optional)
{% if env_vars.grafana_admin_password is defined %}
GRAFANA_ADMIN_PASSWORD={{ env_vars.grafana_admin_password }}
{% endif %}

# Additional environment-specific variables
{% for key, value in env_vars.items() %}
{% if key not in ['database_url', 'supabase_url', 'supabase_anon_key', 'supabase_service_key', 'gemini_api_key', 'n8n_url', 'n8n_api_key', 'mcp_server_url', 'livekit_url', 'livekit_api_key', 'livekit_secret_key', 'stripe_secret_key', 'stripe_webhook_secret', 'frontend_image', 'backend_image', 'grafana_admin_password'] %}
{{ key | upper }}={{ value }}
{% endif %}
{% endfor %}