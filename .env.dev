# =============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains development-specific environment variables
# Copy values from your main .env and modify as needed for development

# =============================================================================
# CORE APPLICATION CONFIGURATION
# =============================================================================

# Environment
NODE_ENV=development
PYTHONPATH=/app/agent

# Development Ports (different from production to avoid conflicts)
FRONTEND_DEV_PORT=3001
BACKEND_DEV_PORT=8001
REDIS_DEV_PORT=6380
N8N_DEV_PORT=5679
NGINX_DEV_PORT=8080

# =============================================================================
# DEVELOPMENT SITE CONFIGURATION
# =============================================================================

# Development URLs (using wildcard SSL subdomain)
DEV_SITE_URL=https://dev.consulting.sa
DEV_ADMIN_URL=https://dev.consulting.sa/api
NEXT_PUBLIC_SITE_URL=https://dev.consulting.sa
NEXT_PUBLIC_ADMIN_URL=https://dev.consulting.sa/api

# Development flags
DEBUG=true
VERBOSE_LOGGING=true
FORCE_HTTPS=true

