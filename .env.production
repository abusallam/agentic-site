# Production Environment Variables for Coolify Deployment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Domain Configuration
NEXT_PUBLIC_SITE_URL=https://consulting.sa

# Contact Configuration
NEXT_PUBLIC_CONTACT_EMAIL=asim@consulting.sa

# Supabase Configuration (to be set in Coolify)
