# Main VPS Configuration
VPS_HOST=your_vps_ip_here
VPS_USER=root
VPS_PASSWORD=your_vps_password_here
VPS_PORT=22

# Environment
ENVIRONMENT=production
NODE_ENV=production

# Domain Configuration
DOMAIN=your_domain_here
FRONTEND_URL=https://your_domain_here
BACKEND_URL=https://your_domain_here/api

# Database Configuration (Supabase)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
DATABASE_URL=your_database_url_here

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Services (will be installed on main VPS)
N8N_URL=http://your_vps_ip:5678
N8N_API_KEY=will_be_generated_after_install
MCP_SERVER_URL=http://your_vps_ip:3001

# Monitoring (will be installed on main VPS)
PROMETHEUS_URL=http://your_vps_ip:9090
GRAFANA_URL=http://your_vps_ip:3001
GRAFANA_ADMIN_PASSWORD=admin123

# Optional Services
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# GitHub Configuration
GITHUB_TOKEN=your_github_token_here
GITHUB_REPOSITORY=your_github_username/your_repo_name

# Security
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here