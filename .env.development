# =============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains development-specific environment variables
# Copy values from your main .env and modify as needed for development

# =============================================================================
# CORE APPLICATION CONFIGURATION
# =============================================================================

# Environment
NODE_ENV=development
PYTHONPATH=/app/agent

# Development Ports (different from production to avoid conflicts)
FRONTEND_DEV_PORT=3001
BACKEND_DEV_PORT=8001
REDIS_DEV_PORT=6380
N8N_DEV_PORT=5679
NGINX_DEV_PORT=8080

# =============================================================================
# DEVELOPMENT SITE CONFIGURATION
# =============================================================================

# Development URLs (using wildcard SSL subdomain)
DEV_SITE_URL=https://dev.consulting.sa
DEV_ADMIN_URL=https://dev.consulting.sa/api
NEXT_PUBLIC_SITE_URL=https://dev.consulting.sa
NEXT_PUBLIC_ADMIN_URL=https://dev.consulting.sa/api

# Development flags
DEBUG=true
VERBOSE_LOGGING=true
FORCE_HTTPS=true

# =============================================================================
# SUPABASE DATABASE CONFIGURATION
# =============================================================================
# Use the same Supabase project as production but with dev table prefixes
# Tables will be prefixed with 'dev_' to separate from production data

# Supabase Project Configuration (same as production)
NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY}
SUPABASE_SERVICE_KEY=${SUPABASE_SERVICE_KEY}

# Development Database Settings
DEV_TABLE_PREFIX=dev_
DEV_SCHEMA=development

# =============================================================================
# AI SERVICES CONFIGURATION
# =============================================================================
# Same as production - AI services can be shared

# Google Gemini AI (same as production)
GEMINI_API_KEY=${GEMINI_API_KEY}

# OpenAI (optional - same as production)
OPENAI_API_KEY=${OPENAI_API_KEY}

# Anthropic Claude (optional - same as production)
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}

# =============================================================================
# PAYMENT INTEGRATION (STRIPE) - USE TEST KEYS
# =============================================================================

# Stripe Test Configuration (use test keys for development)
STRIPE_TEST_SECRET_KEY=sk_test_your_stripe_test_secret_key
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_your_stripe_test_publishable_key
STRIPE_TEST_WEBHOOK_SECRET=whsec_test_your_test_webhook_secret

# =============================================================================
# COMMUNICATION SERVICES
# =============================================================================
# You can use the same services or create separate dev instances

# Livekit Real-time Communication (can use same or separate dev instance)
LIVEKIT_DEV_URL=wss://your-dev-livekit-server.com
LIVEKIT_DEV_API_KEY=your_dev_livekit_api_key
LIVEKIT_DEV_API_SECRET=your_dev_livekit_api_secret

# Fallback to production if dev not available
LIVEKIT_URL=wss://your-livekit-server.com
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# =============================================================================
# WORKFLOW AUTOMATION (N8N) - DEVELOPMENT INSTANCE
# =============================================================================

# n8n Development Configuration
N8N_DEV_URL=http://n8n-dev:5678
N8N_DEV_API_KEY=your_dev_n8n_api_key

# Fallback to production n8n if needed
N8N_URL=http://localhost:5678
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key

# =============================================================================
# MCP SERVER CONFIGURATION
# =============================================================================

# Model Context Protocol Server (development ports)
MCP_SERVER_URL=http://localhost:8001
MCP_SERVER_PORT=8001
N8N_MCP_PORT=8004

# =============================================================================
# GITHUB INTEGRATION
# =============================================================================

# GitHub Token (same as production)
GITHUB_TOKEN=ghp_your_github_personal_access_token

# =============================================================================
# VPS SERVER INFORMATION
# =============================================================================

# Development VPS Details
VPS_IP=217.79.255.54
VPS_USER=root
VPS_PASSWORD=gt5qXy22aJ
SSH_ALIAS=agentic-217-79-255-54

# =============================================================================
# DEVELOPMENT-SPECIFIC CONFIGURATION
# =============================================================================

# ADK Agent Configuration
ADK_AGENT_PORT=8001
ADK_LOG_LEVEL=DEBUG

# Contact Configuration
NEXT_PUBLIC_CONTACT_EMAIL=dev@consulting.sa

# Analytics (disabled for development)
NEXT_PUBLIC_GA_ID=

# Docker Compose Configuration
COMPOSE_PROJECT_NAME=agentic-dev
COMPOSE_HTTP_TIMEOUT=120
DOMAIN=dev.consulting.sa

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# Development Debugging
NEXT_TELEMETRY_DISABLED=1
ANALYZE=false

# =============================================================================
# INSTRUCTIONS
# =============================================================================
#
# 1. Copy your production values from .env to this file
# 2. Modify ports and URLs for development
# 3. Use test API keys where applicable (especially Stripe)
# 4. Set DEBUG=true and VERBOSE_LOGGING=true
# 5. Deploy using: ./infrastructure/scripts/deploy-dev-vps.sh
#
# =============================================================================