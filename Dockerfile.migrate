# Database Migration Dockerfile
FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install supabase python-dotenv

WORKDIR /app

# Copy migration files
COPY setup_database.py ./
COPY supabase/ ./supabase/
COPY agent/database_schema.sql ./agent/
COPY .env* ./

# Create migration script
RUN cat > migrate.sh << 'EOF'
#!/bin/bash
set -e

echo "🗄️ Running database migrations..."

# Wait for backend to be ready
echo "Waiting for backend service..."
sleep 30

# Run database setup
python setup_database.py

echo "✅ Database migration completed!"
EOF

RUN chmod +x migrate.sh

# Create non-root user
RUN groupadd --gid 1001 migrate && \
    useradd --uid 1001 --gid migrate --shell /bin/bash --create-home migrate

RUN chown -R migrate:migrate /app

USER migrate

CMD ["./migrate.sh"]