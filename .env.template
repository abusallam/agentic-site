# 🚀 AGENTIC AI PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# This template contains all required environment variables for the systematic deployment
# Copy this file to .env and fill in your actual values
#
# SECURITY NOTE: Never commit .env files to version control
# This template serves as documentation for required variables

# =============================================================================
# PROJECT CONFIGURATION
# =============================================================================
PROJECT_NAME=agentic
ENVIRONMENT=production  # production | development | staging
VERSION=1.0.0

# =============================================================================
# VPS AND INFRASTRUCTURE CONFIGURATION
# =============================================================================
VPS_HOST=217.79.255.54
VPS_USER=root
VPS_PASSWORD=your_vps_password_here
SSH_KEY_PATH=/path/to/your/ssh/key

# Domain Configuration
DOMAIN=consulting.sa
PRODUCTION_DOMAIN=main.consulting.sa
DEVELOPMENT_DOMAIN=dev.consulting.sa
MONITORING_DOMAIN=monitoring.consulting.sa

# SSL Configuration
SSL_CERT_PATH=/opt/ssl/consulting.sa.crt
SSL_KEY_PATH=/opt/ssl/consulting.sa.key

# =============================================================================
# DATABASE CONFIGURATION (SUPABASE)
# =============================================================================
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Database Connection (if using direct PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# =============================================================================
# AI SERVICES CONFIGURATION
# =============================================================================
# Google Gemini API (Primary AI Service)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# OpenAI API (Alternative/Backup)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API (Alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# REAL-TIME COMMUNICATION (LIVEKIT)
# =============================================================================
# Get these from your Livekit Cloud account or self-hosted instance
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# =============================================================================
# PAYMENT PROCESSING (STRIPE)
# =============================================================================
# Get these from your Stripe dashboard
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# =============================================================================
# WORKFLOW AUTOMATION (N8N)
# =============================================================================
# N8N Configuration
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_secure_n8n_password_here
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=https://main.consulting.sa/webhook/
GENERIC_TIMEZONE=UTC

# N8N Database (if using external database)
N8N_DATABASE_TYPE=postgresdb
N8N_DATABASE_HOST=your_postgres_host
N8N_DATABASE_PORT=5432
N8N_DATABASE_NAME=n8n
N8N_DATABASE_USER=n8n_user
N8N_DATABASE_PASSWORD=your_n8n_db_password

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Configuration
JWT_SECRET=your_very_long_and_secure_jwt_secret_here_minimum_32_characters
JWT_EXPIRES_IN=7d

# Encryption Keys
ENCRYPTION_KEY=your_32_character_encryption_key_here
ENCRYPTION_ALGORITHM=aes-256-gcm

# Session Configuration
SESSION_SECRET=your_session_secret_here_minimum_32_characters
SESSION_MAX_AGE=86400000  # 24 hours in milliseconds

# CORS Configuration
CORS_ORIGIN=https://main.consulting.sa,https://dev.consulting.sa
CORS_CREDENTIALS=true

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
# Log Level (error | warn | info | debug)
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# Alerting Configuration
ALERT_EMAIL=admin@consulting.sa
ALERT_WEBHOOK_URL=https://hooks.slack.com/your/slack/webhook
ALERT_THRESHOLD_CPU=80
ALERT_THRESHOLD_MEMORY=80
ALERT_THRESHOLD_DISK=85

# =============================================================================
# GITHUB INTEGRATION (CI/CD)
# =============================================================================
# GitHub Configuration for automated deployments
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPOSITORY=your-username/agentic-site
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Branch Configuration
PRODUCTION_BRANCH=main
DEVELOPMENT_BRANCH=develop
STAGING_BRANCH=staging

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SMTP Configuration for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_here

# Email Templates
FROM_EMAIL=noreply@consulting.sa
ADMIN_EMAIL=admin@consulting.sa
SUPPORT_EMAIL=support@consulting.sa

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis Connection
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# Redis Cluster (if using cluster)
REDIS_CLUSTER_NODES=redis1:6379,redis2:6379,redis3:6379

# =============================================================================
# BACKUP AND STORAGE
# =============================================================================
# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_here

# S3 Compatible Storage (for backups)
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=your-backup-bucket
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_REGION=us-east-1

# =============================================================================
# SECURITY MONITORING
# =============================================================================
# Intrusion Detection
IDS_ENABLED=true
IDS_ALERT_EMAIL=security@consulting.sa
IDS_LOG_LEVEL=warn

# Penetration Testing
PENTEST_ENABLED=true
PENTEST_SCHEDULE=0 3 * * 0  # Weekly on Sunday at 3 AM
PENTEST_REPORT_EMAIL=security@consulting.sa

# Hardware Security Monitoring
HARDWARE_MONITORING_ENABLED=true
HARDWARE_ALERT_THRESHOLD=high

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
# Application Performance
MAX_REQUEST_SIZE=100mb
REQUEST_TIMEOUT=30000  # 30 seconds
RATE_LIMIT_WINDOW=900000  # 15 minutes
RATE_LIMIT_MAX=100

# Database Performance
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=5000
DB_IDLE_TIMEOUT=10000

# Cache Configuration
CACHE_TTL=3600  # 1 hour
CACHE_MAX_SIZE=100mb

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Feature toggles for gradual rollout
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_MULTI_LANGUAGE=true
FEATURE_REAL_TIME_CHAT=true
FEATURE_PAYMENT_PROCESSING=true
FEATURE_WORKFLOW_AUTOMATION=true
FEATURE_SECURITY_MONITORING=true

# =============================================================================
# DEVELOPMENT SPECIFIC CONFIGURATION
# =============================================================================
# Only used in development environment
DEBUG=false
HOT_RELOAD=true
SOURCE_MAPS=true
MOCK_EXTERNAL_APIS=false

# Development Database (if different from production)
DEV_DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/dev_database

# Development Ports (different from production)
DEV_FRONTEND_PORT=3001
DEV_BACKEND_PORT=8001
DEV_REDIS_PORT=6380
DEV_N8N_PORT=5679

# =============================================================================
# COMPLIANCE AND AUDIT
# =============================================================================
# GDPR Compliance
GDPR_ENABLED=true
DATA_RETENTION_DAYS=365
COOKIE_CONSENT_REQUIRED=true

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_LEVEL=info
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years

# Compliance Reporting
COMPLIANCE_REPORTS_ENABLED=true
COMPLIANCE_REPORT_EMAIL=compliance@consulting.sa

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================
# Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX-X
MIXPANEL_TOKEN=your_mixpanel_token_here

# Social Media
TWITTER_API_KEY=your_twitter_api_key
LINKEDIN_API_KEY=your_linkedin_api_key

# Customer Support
INTERCOM_APP_ID=your_intercom_app_id
ZENDESK_SUBDOMAIN=your_zendesk_subdomain
ZENDESK_API_TOKEN=your_zendesk_api_token

# =============================================================================
# CONTAINER CONFIGURATION
# =============================================================================
# Docker Configuration
DOCKER_REGISTRY=ghcr.io
DOCKER_NAMESPACE=your-username
DOCKER_TAG=latest

# Container Resources
FRONTEND_MEMORY_LIMIT=512m
BACKEND_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=256m
N8N_MEMORY_LIMIT=512m

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=40s

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# Deployment Settings
DEPLOYMENT_STRATEGY=rolling
DEPLOYMENT_TIMEOUT=600  # 10 minutes
ROLLBACK_ENABLED=true
ROLLBACK_TIMEOUT=300  # 5 minutes

# Zero-Downtime Deployment
BLUE_GREEN_DEPLOYMENT=true
HEALTH_CHECK_BEFORE_SWITCH=true
TRAFFIC_SWITCH_DELAY=30  # seconds

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================
# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
SLACK_CHANNEL=#deployments
SLACK_USERNAME=DeployBot

# Discord Integration
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/discord/webhook

# Microsoft Teams Integration
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your/teams/webhook

# =============================================================================
# CUSTOM APPLICATION CONFIGURATION
# =============================================================================
# Add your application-specific environment variables here
# Example:
# CUSTOM_API_ENDPOINT=https://api.example.com
# CUSTOM_API_KEY=your_custom_api_key
# CUSTOM_FEATURE_FLAG=true

# =============================================================================
# ENVIRONMENT VALIDATION
# =============================================================================
# These variables are used by the validation script
REQUIRED_VARS=PROJECT_NAME,ENVIRONMENT,VPS_HOST,DOMAIN,SUPABASE_URL,GOOGLE_API_KEY
OPTIONAL_VARS=STRIPE_SECRET_KEY,LIVEKIT_API_KEY,N8N_BASIC_AUTH_PASSWORD
SENSITIVE_VARS=VPS_PASSWORD,SUPABASE_SERVICE_ROLE_KEY,JWT_SECRET,ENCRYPTION_KEY

# =============================================================================
# NOTES AND DOCUMENTATION
# =============================================================================
# 1. Replace all placeholder values with your actual configuration
# 2. Ensure all sensitive values are properly secured
# 3. Use strong passwords and keys (minimum 32 characters for secrets)
# 4. Regularly rotate API keys and passwords
# 5. Test configuration in development before deploying to production
# 6. Keep this template updated when adding new features
# 7. Use environment-specific .env files (.env.production, .env.development)
# 8. Validate configuration using the provided validation script
#
# For more information, see:
# - Documentation: docs/configuration.md
# - Validation: infrastructure/scripts/validate-environment.sh
# - Security: docs/security.md